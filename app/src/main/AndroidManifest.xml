<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Playback (T6): foreground media service, ExoPlayer local wake lock, notification (runtime grant = UI). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Library scan (MediaStore) and on-demand LRCLIB lyrics lookups. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- API 26-28 only: "Delete from device" removes a file directly (scoped storage and the system's delete request start at 29/30). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- API 31+: only to show the connected Bluetooth device's NAME on the player's output chip (asked in context). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Self-update from GitHub Releases: the system installer session is started by the app (user confirms in the system dialog). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MusicPlayerApp"
        android:allowBackup="false"
        android:largeHeap="false"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicPlayer">
        <!-- Android Auto: this app is a media app (the browse tree comes from PlaybackService). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.MusicPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Voice "play ..." requests from Assistant / head units: opens the search screen (no query yet). -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Exported without a permission on purpose: Media3 session clients (system UI, Bluetooth, Auto) bind to it. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
            <!-- Legacy browser clients (older Android Auto, Bluetooth head units, Assistant). -->
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Status of the self-update install session; only the system's PendingIntent reaches it. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />

        <!-- Headset / Bluetooth media buttons, also when the app process is not running. -->
        <receiver
            android:name=".playback.MediaButtonRestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (RemoteViews, redrawn on playback state changes only). -->
        <receiver
            android:name=".appwidget.CompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_compact" />
        </receiver>

        <receiver
            android:name=".appwidget.SquareWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_square" />
        </receiver>

        <receiver
            android:name=".appwidget.WideWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_wide" />
        </receiver>

        <!-- Widget buttons. Not exported: only our own PendingIntents reach it. -->
        <receiver
            android:name=".appwidget.WidgetActionReceiver"
            android:exported="false" />
    </application>

</manifest>
