<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Scr.PageTitle" parent="">
        <item name="android:textSize">@dimen/mp_text_display</item>
        <item name="android:fontFamily">@font/mp_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/mpOnSurface</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Scr.SectionTitle" parent="">
        <item name="android:textSize">@dimen/mp_text_headline</item>
        <item name="android:fontFamily">@font/mp_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">400</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/mpOnSurface</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Library.TileTitle" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/mp_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:textColor">?attr/mpOnSurface</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Library.LikedTitle" parent="Library.TileTitle">
        <item name="android:textSize">30sp</item>
    </style>
    <style name="Scr.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/mpOnSurfaceVariant</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Scr.GroupLabel" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/mpPrimary</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Search.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/search_chip_bg</item>
        <item name="android:textColor">@color/search_chip_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Settings.RowTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/mpOnSurface</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Settings.RowSub" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/mpOnSurfaceVariant</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Settings.Switch" parent="">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/mpOnSurface</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
</resources>
