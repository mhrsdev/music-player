<resources>
    <style name="Nav.Tab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/scr_on_surface_variant</item>
        <item name="android:drawableTint">@color/scr_on_surface_variant</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Scr.PageTitle" parent="">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/scr_on_surface</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Scr.SectionTitle" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/scr_on_surface</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Scr.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/scr_on_surface_variant</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Scr.GroupLabel" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/scr_primary</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Search.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/search_chip_bg</item>
        <item name="android:textColor">@color/search_chip_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Settings.RowTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/scr_on_surface</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Settings.RowSub" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/scr_on_surface_variant</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
    <style name="Settings.Switch" parent="">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/scr_on_surface</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
</resources>
