<?xml version="1.0" encoding="utf-8"?>
<!-- Mowj launcher background: lapis -> turquoise diagonal across the 72dp visible area of the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="@color/brand_lapis"
                android:endColor="@color/brand_turquoise" />
        </aapt:attr>
    </path>
</vector>
