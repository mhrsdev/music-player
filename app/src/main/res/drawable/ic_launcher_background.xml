<?xml version="1.0" encoding="utf-8"?>
<!-- Mowj launcher background: lapis -> turquoise diagonal plus a soft turquoise glow from the top left. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="18"
                android:endX="86"
                android:endY="90">
                <item android:offset="0" android:color="@color/brand_lapis" />
                <item android:offset="0.55" android:color="@color/brand_lapis_teal" />
                <item android:offset="1" android:color="@color/brand_turquoise" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="40"
                android:centerY="30"
                android:gradientRadius="52"
                android:startColor="@color/brand_glow"
                android:endColor="@color/brand_glow_clear" />
        </aapt:attr>
    </path>
</vector>
