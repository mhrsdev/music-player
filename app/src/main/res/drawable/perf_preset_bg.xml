<?xml version="1.0" encoding="utf-8"?>
<!-- A preset row inside the card: chosen = secondary container tile, others flat; ripple on both. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item android:id="@android:id/mask"><shape><corners android:radius="18dp"/><solid android:color="#FFFFFFFF"/></shape></item>
    <item>
        <selector>
            <item android:state_selected="true"><shape><corners android:radius="18dp"/><solid android:color="?attr/mpSecondaryContainer"/></shape></item>
            <item><shape><corners android:radius="18dp"/><solid android:color="@android:color/transparent"/></shape></item>
        </selector>
    </item>
</ripple>
