<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_root"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/nav_mini_bg"
    android:contentDescription="@string/nav_open_player"
    android:elevation="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/mini_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="anyRtl"
            android:textColor="@color/scr_on_primary_container"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="anyRtl"
            android:textColor="@color/scr_on_primary_container"
            android:alpha="0.8"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mini_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_play"
        android:src="@drawable/nav_ic_play"
        android:tint="@color/scr_on_primary_container" />
</LinearLayout>
