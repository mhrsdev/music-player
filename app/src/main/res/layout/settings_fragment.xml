<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (DESIGN.md 09): grouped cards. Rows for folders / feature screens / about are added by SettingsFragment. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/scr_bottom_chrome">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView style="@style/Scr.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_title" />

        <!-- Appearance -->
        <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_appearance" />
        <LinearLayout style="@style/Settings.Card">
            <TextView style="@style/Settings.CardTitle" android:text="@string/settings_theme" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout style="@style/Settings.ChipStrip">
                    <TextView android:id="@+id/theme_system" style="@style/Search.Chip" android:text="@string/settings_theme_system" />
                    <TextView android:id="@+id/theme_light" style="@style/Search.Chip" android:text="@string/settings_theme_light" />
                    <TextView android:id="@+id/theme_dark" style="@style/Search.Chip" android:text="@string/settings_theme_dark" />
                    <TextView android:id="@+id/theme_black" style="@style/Search.Chip" android:text="@string/settings_theme_black" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
        <LinearLayout style="@style/Settings.Card">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/artwork_colors" style="@style/Settings.CardSwitch" android:text="@string/settings_artwork_colors" />
            <TextView style="@style/Settings.CardSub" android:importantForAccessibility="no" android:text="@string/settings_artwork_colors_sub" />
        </LinearLayout>

        <!-- Language -->
        <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_language" />
        <LinearLayout style="@style/Settings.Card" android:paddingTop="12dp">
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout style="@style/Settings.ChipStrip">
                    <TextView android:id="@+id/lang_system" style="@style/Search.Chip" android:text="@string/settings_lang_system" />
                    <TextView android:id="@+id/lang_en" style="@style/Search.Chip" android:text="@string/settings_lang_en" />
                    <TextView android:id="@+id/lang_fa" style="@style/Search.Chip" android:text="@string/settings_lang_fa" />
                </LinearLayout>
            </HorizontalScrollView>
            <TextView style="@style/Settings.CardSub" android:text="@string/settings_lang_sub" />
        </LinearLayout>

        <!-- Library -->
        <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_library" />
        <LinearLayout style="@style/Settings.Card">
            <TextView style="@style/Settings.CardTitle" android:accessibilityHeading="true" android:text="@string/settings_folders" />
            <TextView android:id="@+id/folders_hint" style="@style/Settings.CardSub" android:paddingBottom="4dp" />
            <LinearLayout android:id="@+id/folders_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp" />
            <LinearLayout android:id="@+id/folders_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rescan_card" style="@style/Settings.Card" />

        <!-- Player & lyrics -->
        <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_player_lyrics" />
        <LinearLayout style="@style/Settings.Card">
            <TextView style="@style/Settings.CardTitle" android:text="@string/settings_seek_style" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout style="@style/Settings.ChipStrip">
                    <TextView android:id="@+id/seek_wavy" style="@style/Search.Chip" android:text="@string/settings_seek_wavy" />
                    <TextView android:id="@+id/seek_waveform" style="@style/Search.Chip" android:text="@string/settings_seek_waveform" />
                    <TextView android:id="@+id/seek_bars" style="@style/Search.Chip" android:text="@string/settings_seek_bars" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
        <LinearLayout style="@style/Settings.Card">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/online_lyrics" style="@style/Settings.CardSwitch" android:text="@string/settings_lyrics_online" />
            <TextView style="@style/Settings.CardSub" android:importantForAccessibility="no" android:text="@string/settings_lyrics_online_sub" />
        </LinearLayout>
        <LinearLayout style="@style/Settings.Card">
            <TextView style="@style/Settings.CardTitle" android:text="@string/settings_sleep_default" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:id="@+id/sleep_row" style="@style/Settings.ChipStrip" />
            </HorizontalScrollView>
        </LinearLayout>
        <LinearLayout style="@style/Settings.Card">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/battery_saver" style="@style/Settings.CardSwitch" android:text="@string/settings_battery_saver" />
            <TextView style="@style/Settings.CardSub" android:importantForAccessibility="no" android:text="@string/settings_battery_saver_sub" />
        </LinearLayout>

        <!-- Feature screens from other packages (FeatureScreens registry); hidden when none is in the build. -->
        <TextView android:id="@+id/features_label" style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_more" />
        <LinearLayout android:id="@+id/features_card" style="@style/Settings.Card" />

        <!-- About -->
        <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/settings_about" />
        <LinearLayout android:id="@+id/about_card" style="@style/Settings.Card" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
