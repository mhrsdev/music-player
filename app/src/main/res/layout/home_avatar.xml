<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/library_row_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <com.mhrsdev.musicplayer.ui.widget.ArtworkView
        android:id="@+id/art"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/mpOnSurface"
        android:textDirection="anyRtl"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Title" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textDirection="anyRtl"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Supporting" />
</LinearLayout>
