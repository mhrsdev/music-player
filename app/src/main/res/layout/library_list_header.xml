<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="56dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/art_box"
        android:layout_width="200dp"
        android:layout_height="200dp">

        <com.mhrsdev.musicplayer.ui.widget.ArtworkView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Built-in lists (Liked, History, ...): their symbol on the seeded gradient instead of a note. -->
        <ImageView
            android:id="@+id/art_icon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="#F2FFFFFF" />

        <!-- Playlists: 2x2 mosaic of the first covers. -->
        <com.mhrsdev.musicplayer.ui.library.MosaicArtView
            android:id="@+id/mosaic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textDirection="anyRtl"
        android:textColor="?attr/mpOnSurface"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Scr.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textDirection="anyRtl" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/play"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/nav_button_primary"
            android:clickable="true"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/mpOnPrimary"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:text="@string/library_play_all"
            android:textColor="?attr/mpOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shuffle"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/library_tonal_button"
            android:clickable="true"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/mpOnSecondaryContainer"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/library_shuffle"
            android:textColor="?attr/mpOnSecondaryContainer"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/header_more"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/library_tonal_button"
            android:contentDescription="@string/u2_playlist_options"
            android:src="@drawable/nav_ic_more"
            android:visibility="gone"
            app:tint="?attr/mpOnSecondaryContainer" />
    </LinearLayout>

    <!-- Sort + select: quiet text pills under the primary actions. -->
    <LinearLayout
        android:id="@+id/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sort"
            style="@style/U2.ActionPill"
            android:drawableStart="@drawable/u2_ic_sort"
            android:layout_marginEnd="0dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/select"
            style="@style/U2.ActionPill"
            android:layout_marginEnd="0dp"
            android:drawableStart="@drawable/u2_ic_select_all"
            android:text="@string/u2_select" />
    </LinearLayout>
</LinearLayout>
