<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/queue_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/queue_sheet_bg"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingBottom="8dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/queue_handle_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/queue_sleep"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/queue_sleep_bg"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:minWidth="48dp"
            android:paddingHorizontal="14dp"
            android:textColor="#D4E3FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="@string/player_sleep_timer"
            app:drawableStartCompat="@drawable/player_ic_sleep"
            app:drawableTint="#D4E3FF" />

        <TextView
            android:id="@+id/queue_playing_from"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@drawable/queue_chip_bg"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="#E2E2E9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/queue_shuffle"
            style="@style/Player.IconButton"
            android:contentDescription="@string/queue_shuffle"
            android:src="@drawable/player_ic_shuffle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queue_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="240dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/queue_empty"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:gravity="center"
            android:text="@string/queue_empty"
            android:textColor="#BFC6D2"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
