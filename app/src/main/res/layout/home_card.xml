<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="152dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/library_row_bg"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/art_frame"
        android:layout_width="match_parent"
        android:layout_height="144dp">

        <com.mhrsdev.musicplayer.ui.widget.ArtworkView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <com.mhrsdev.musicplayer.ui.widget.MorphPlayPauseView
            android:id="@+id/play"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="anyRtl"
        android:textColor="?attr/mpOnSurface"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Title" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="anyRtl"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Supporting" />
</LinearLayout>
