<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/scr_bottom_chrome">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:src="@drawable/nav_ic_back"
            app:tint="?attr/mpOnSurface" />

        <TextView style="@style/Scr.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:paddingTop="4dp" android:text="@string/backup_title" />
        <TextView style="@style/Scr.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:text="@string/backup_intro" />

        <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/backup_export_group" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/backup_card_bg"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView style="@style/Scr.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_export_body" />
            <TextView
                android:id="@+id/export"
                style="@style/Backup.Button"
                android:background="@drawable/nav_button_primary"
                android:text="@string/backup_export_action"
                android:textColor="?attr/mpOnPrimary" />
        </LinearLayout>

        <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/backup_restore_group" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/backup_card_bg"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView style="@style/Scr.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_restore_body" />
            <TextView
                android:id="@+id/choose"
                style="@style/Backup.Button"
                android:background="@drawable/library_tonal_button"
                android:text="@string/backup_choose_action"
                android:textColor="?attr/mpOnSecondaryContainer" />

            <LinearLayout
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="0dp" android:text="@string/backup_in_file" />
                <include android:id="@+id/row_playlists" layout="@layout/backup_stat_row" />
                <include android:id="@+id/row_likes" layout="@layout/backup_stat_row" />
                <include android:id="@+id/row_plays" layout="@layout/backup_stat_row" />
                <include android:id="@+id/row_settings" layout="@layout/backup_stat_row" />
                <include android:id="@+id/row_unmatched" layout="@layout/backup_stat_row" />
                <TextView
                    android:id="@+id/unmatched_sub"
                    style="@style/Scr.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="@string/backup_unmatched_sub"
                    android:textSize="13sp" />

                <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="0dp" android:text="@string/backup_mode_label" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/mode_merge" style="@style/Search.Chip" android:layout_marginStart="0dp" android:text="@string/backup_mode_merge" />
                    <TextView android:id="@+id/mode_replace" style="@style/Search.Chip" android:text="@string/backup_mode_replace" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mode_sub"
                    style="@style/Scr.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/restore"
                    style="@style/Backup.Button"
                    android:background="@drawable/nav_button_primary"
                    android:text="@string/backup_restore_action"
                    android:textColor="?attr/mpOnPrimary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:textAlignment="viewStart"
            android:textColor="?attr/mpOnSurface"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
