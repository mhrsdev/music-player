<?xml version="1.0" encoding="utf-8"?>
<!-- Single-activity shell: screens, bottom scrim, mini-player, floating nav, full-player layer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mpBackground">

    <!-- Home ambient glow (DESIGN.md expression budget #1): full-bleed from y=0 under the transparent status bar,
         eased to alpha 0, pinned behind the scroller so it never ends in a hard edge. Static: no per-frame work. -->
    <View
        android:id="@+id/home_glow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom" />

    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Mini-player (T2 widget). -->
        <FrameLayout
            android:id="@+id/mini_player_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/mp_dock_margin_h"
            android:layout_marginBottom="@dimen/mp_dock_gap">

            <com.mhrsdev.musicplayer.ui.widget.MiniPlayerView
                android:id="@+id/mini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Floating pill nav (T2 widget). -->
        <FrameLayout
            android:id="@+id/nav_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/mp_dock_margin_h">

            <com.mhrsdev.musicplayer.ui.widget.FloatingNavView
                android:id="@+id/nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />
        </FrameLayout>
    </LinearLayout>

    <!-- Full player (T4) is added here over everything. -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
