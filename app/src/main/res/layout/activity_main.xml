<?xml version="1.0" encoding="utf-8"?>
<!-- Single-activity shell: screens, bottom scrim, mini-player, floating nav, full-player layer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scr_bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/nav_bottom_scrim" />

    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Slot for T2's MiniPlayerView; the temporary bar below lives here until it lands. -->
        <FrameLayout
            android:id="@+id/mini_player_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp">

            <include
                android:id="@+id/mini"
                layout="@layout/nav_mini_player" />
        </FrameLayout>

        <!-- Slot for T2's FloatingNavView; temporary pill nav until it lands. -->
        <FrameLayout
            android:id="@+id/nav_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">

            <include
                android:id="@+id/nav"
                layout="@layout/nav_floating_bar" />
        </FrameLayout>
    </LinearLayout>

    <!-- Full player (T4) is added here over everything. -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
