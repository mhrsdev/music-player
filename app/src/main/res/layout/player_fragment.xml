<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:background="#0F1216">

    <com.mhrsdev.musicplayer.ui.player.PlayerBackdropView
        android:id="@+id/player_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/player_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/player_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/queue_handle_bg"
            android:importantForAccessibility="no" />

        <!-- Top row (mirrors in RTL): lyrics toggle · pill toggle group · heart -->
        <LinearLayout
            android:id="@+id/player_top"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/player_lyrics_toggle"
                style="@style/Player.IconButton"
                android:contentDescription="@string/player_show_lyrics"
                android:src="@drawable/player_ic_lyrics" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/player_toggle_group"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/player_group_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/player_shuffle"
                    style="@style/Player.ToggleButton"
                    android:contentDescription="@string/player_shuffle_off"
                    android:src="@drawable/player_ic_shuffle" />

                <ImageButton
                    android:id="@+id/player_repeat"
                    style="@style/Player.ToggleButton"
                    android:layout_marginHorizontal="3dp"
                    android:contentDescription="@string/player_repeat_off"
                    android:src="@drawable/player_ic_repeat" />

                <ImageButton
                    android:id="@+id/player_queue"
                    style="@style/Player.ToggleButton"
                    android:contentDescription="@string/player_queue"
                    android:src="@drawable/player_ic_queue" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/player_like"
                style="@style/Player.IconButton"
                android:contentDescription="@string/player_like"
                android:src="@drawable/player_ic_favorite_border" />
        </LinearLayout>

        <!-- Stage: cover or lyrics -->
        <FrameLayout
            android:id="@+id/player_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.mhrsdev.musicplayer.ui.widget.ArtworkView
                android:id="@+id/player_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:elevation="18dp"
                android:importantForAccessibility="no" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lyrics_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadingEdgeLength="56dp"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/lyrics_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lyrics_message_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lyrics_message_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#B8FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lyrics_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/player_chip_bg"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/lyrics_retry"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/lyrics_back_to_current"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/player_chip_bg"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/lyrics_back_to_current"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="1"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:textColor="#FFFFFF"
                    android:textDirection="anyRtl"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="Without You" />

                <TextView
                    android:id="@+id/player_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="#B8FFFFFF"
                    android:textDirection="anyRtl"
                    android:textSize="17sp"
                    tools:text="NEFFEX" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/player_more"
                style="@style/Player.IconButton"
                android:contentDescription="@string/player_more"
                android:rotation="90"
                android:src="@drawable/player_ic_more" />
        </LinearLayout>

        <!-- Seek (always LTR, tape direction) -->
        <FrameLayout
            android:id="@+id/player_seek_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layoutDirection="ltr" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/player_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textColor="#C7FFFFFF"
                android:textSize="13sp"
                tools:text="0:52" />

            <TextView
                android:id="@+id/player_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#C7FFFFFF"
                android:textSize="13sp"
                tools:text="-2:09" />
        </LinearLayout>

        <!-- Transport (always LTR) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/player_prev"
                style="@style/Player.SideButton"
                android:contentDescription="@string/player_previous"
                android:src="@drawable/player_ic_prev" />

            <com.mhrsdev.musicplayer.ui.widget.MorphPlayPauseView
                android:id="@+id/player_play"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginHorizontal="12dp" />

            <ImageButton
                android:id="@+id/player_next"
                style="@style/Player.SideButton"
                android:contentDescription="@string/player_next"
                android:src="@drawable/player_ic_next" />

        </LinearLayout>

        <!-- Output chip -->
        <TextView
            android:id="@+id/player_output"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/player_chip_bg"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/player_output_device"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/player_ic_speaker"
            app:drawableTint="#FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</FrameLayout>
