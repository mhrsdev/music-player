<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/shuffle_all"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/library_tonal_button"
        android:drawablePadding="8dp"
        android:drawableTint="?attr/mpOnSecondaryContainer"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/home_shuffle_library"
        android:textColor="?attr/mpOnSecondaryContainer"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Label" />

    <TextView
        android:id="@+id/surprise"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/library_tonal_button"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/home_surprise"
        android:textColor="?attr/mpOnSecondaryContainer"
        android:textAppearance="@style/TextAppearance.MusicPlayer.Label" />
</LinearLayout>
