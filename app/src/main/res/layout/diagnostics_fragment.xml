<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Diagnostics (X1, D30): plain-language verdict first, one Share action, technical excerpt below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_back"
        android:src="@drawable/nav_ic_back"
        app:tint="?attr/mpOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scr_bottom_chrome">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Scr.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:paddingTop="4dp" android:text="@string/diag_title" />
            <TextView style="@style/Settings.RowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/diag_intro" />

            <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/diag_last_exit" />
            <LinearLayout style="@style/Settings.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:gravity="top"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <View
                        android:id="@+id/verdict_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/diag_dot"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/verdict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textAlignment="viewStart"
                            android:textColor="?attr/mpOnSurface"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/verdict_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAlignment="viewStart"
                            android:textColor="?attr/mpOnSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/crash_label" style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/diag_last_crash" />
            <LinearLayout android:id="@+id/crash_card" style="@style/Settings.Card" android:paddingHorizontal="12dp" android:paddingVertical="12dp">
                <TextView
                    android:id="@+id/crash_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="8dp"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/mpOnSurfaceVariant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/crash_excerpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/diag_mono_bg"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/mpOnSurface"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/share"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/nav_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/diag_share"
                android:textAllCaps="false"
                android:textColor="?attr/mpOnPrimary"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/clear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/diag_clear"
                android:textAllCaps="false"
                android:textColor="?attr/mpOnSurfaceVariant"
                android:textSize="14sp" />

            <!-- PT1 (D38): frame timing + thermal / memory / GC / CPU snapshots, shared as text. Off by default. -->
            <TextView style="@style/Scr.GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:layout_marginTop="12dp" android:text="@string/perf_title" />
            <LinearLayout style="@style/Settings.Card">
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/perf_switch" style="@style/Settings.CardSwitch" android:text="@string/perf_record" />
                <TextView style="@style/Settings.CardSub" android:text="@string/perf_record_sub" />
                <TextView
                    android:id="@+id/perf_summary"
                    style="@style/Settings.CardSub"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="?attr/mpOnSurface" />
                <TextView
                    android:id="@+id/perf_worst"
                    style="@style/Settings.CardSub"
                    android:textColor="?attr/mpOnSurface" />
            </LinearLayout>
            <TextView
                android:id="@+id/perf_share"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/library_tonal_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/perf_share"
                android:textAllCaps="false"
                android:textColor="?attr/mpOnSecondaryContainer"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/perf_clear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/perf_clear"
                android:textAllCaps="false"
                android:textColor="?attr/mpOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
