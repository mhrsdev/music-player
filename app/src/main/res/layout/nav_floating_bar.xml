<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/nav_pill_bg"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <TextView android:id="@+id/tab_home" style="@style/Nav.Tab" android:drawableTop="@drawable/nav_ic_home" android:text="@string/nav_home" />
    <TextView android:id="@+id/tab_search" style="@style/Nav.Tab" android:drawableTop="@drawable/nav_ic_search" android:text="@string/nav_search" />
    <TextView android:id="@+id/tab_library" style="@style/Nav.Tab" android:drawableTop="@drawable/nav_ic_library" android:text="@string/nav_library" />
    <TextView android:id="@+id/tab_settings" style="@style/Nav.Tab" android:drawableTop="@drawable/nav_ic_settings" android:text="@string/nav_settings" />
</LinearLayout>
